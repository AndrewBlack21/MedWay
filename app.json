{
  "expo": {
    "name": "PharmaRoute",
    "slug": "pharma-route",
    "platforms": ["ios", "android"],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/medway.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/medway.png",
      "resizeMode": "contain",
      "backgroundColor": "#1D9E75"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pharmaroute.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos sua localização para exibir sua posição no mapa e calcular rotas.",
        "NSLocationAlwaysUsageDescription": "Usamos sua localização para rastreamento de visitas em campo."
      }
    },
    "android": {
      "package": "com.pharmaroute.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDnPQ9mZfKyna9K2Pg9xSJuQy1cPN0gvfg"
        }
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Precisamos da sua localização para mostrar sua posição no mapa.",
          "locationWhenInUsePermission": "Precisamos da sua localização para mostrar sua posição no mapa."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a215be23-8838-44c1-aa22-3d2ebfe628ec"
      }
    },
    "owner": "andrewblackx",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a215be23-8838-44c1-aa22-3d2ebfe628ec"
    }
  }
}
